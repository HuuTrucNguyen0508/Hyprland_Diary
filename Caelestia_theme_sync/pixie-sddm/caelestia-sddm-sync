#!/usr/bin/env bash
# Sync Caelestia wallpaper + scheme colours into the Pixie SDDM theme.
# Target theme is user-writable: /usr/share/sddm/themes/pixie-caelestia
set -euo pipefail

STATE_DIR="${HOME}/.local/state/caelestia"
SCHEME="${STATE_DIR}/scheme.json"
WALL_LINK="${STATE_DIR}/wallpaper/current"
WALL_PATH_FILE="${STATE_DIR}/wallpaper/path.txt"
THEME_DIR="/usr/share/sddm/themes/pixie-caelestia"
THEME_CONF="${THEME_DIR}/theme.conf"
BG="${THEME_DIR}/assets/background.jpg"

hex() {
  local v
  v="$(jq -r "$1" "$SCHEME" 2>/dev/null || true)"
  if [[ -z "$v" || "$v" == "null" ]]; then
    return 1
  fi
  printf '#%s' "${v#\#}"
}

sync_once() {
  if [[ ! -d "$THEME_DIR" ]]; then
    echo "caelestia-sddm-sync: missing theme at $THEME_DIR (run setup once with sudo)" >&2
    return 1
  fi
  if [[ ! -w "$THEME_CONF" || ! -w "$BG" ]]; then
    echo "caelestia-sddm-sync: theme files not writable (re-run setup ownership)" >&2
    return 1
  fi
  if [[ ! -f "$SCHEME" ]]; then
    echo "caelestia-sddm-sync: no scheme.json yet" >&2
    return 0
  fi

  local wall=""
  if [[ -L "$WALL_LINK" || -f "$WALL_LINK" ]]; then
    wall="$(readlink -f "$WALL_LINK" 2>/dev/null || true)"
  fi
  if [[ -z "$wall" || ! -f "$wall" ]] && [[ -f "$WALL_PATH_FILE" ]]; then
    wall="$(<"$WALL_PATH_FILE")"
  fi

  if [[ -n "$wall" && -f "$wall" ]]; then
    if ! cmp -s "$wall" "$BG" 2>/dev/null; then
      cp -f "$wall" "$BG"
      chmod 644 "$BG" || true
    fi
  fi

  local accent bgc text
  accent="$(hex '.colours.primary')" || accent="#A9C78F"
  bgc="$(hex '.colours.background')" || bgc="#1A1C18"
  text="$(hex '.colours.onBackground')" || text="$(hex '.colours.text')" || text="#E3E3DC"

  cat >"$THEME_CONF" <<EOF
[General]
# AUTO-GENERATED by caelestia-sddm-sync — do not edit.
# Wallpaper + colours mirror Caelestia (scheme.json / wallpaper).
background=assets/background.jpg
accentColor=${accent}
autoColor=false
use24HourClock=false
backgroundColor=${bgc}
textColor=${text}
fontFamily=
EOF
}

if [[ "${1:-}" == "--watch" ]]; then
  sync_once || true
  # scheme.json updates after wallpaper changes; also watch wallpaper path.
  inotifywait -q -e close_write,moved_to,create,delete -m \
    "$STATE_DIR" "$STATE_DIR/wallpaper" |
    while read -r _dir _events file; do
      case "$file" in
        scheme.json|path.txt|current)
          sleep 0.15
          sync_once || true
          ;;
      esac
    done
else
  sync_once
fi
