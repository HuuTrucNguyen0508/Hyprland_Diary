#!/usr/bin/env fish

set -l state_dir "$HOME/.local/state/caelestia"
set -l scheme "$state_dir/scheme.json"

function generate_css
    if not test -f "$scheme"
        return
    end

    for chrome_dir in $HOME/.config/zen/*/chrome
        if not test -d "$chrome_dir"
            continue
        end

        set -l css "$chrome_dir/caelestia-colors.css"

        printf '%s\n' \
            '/* AUTO-GENERATED by Caelestia Zen Sync. DO NOT EDIT. */' \
            '' \
            ':root {' \
            "  --zen-colors-primary: #"(jq -r '.colours.primary' $scheme)" !important;" \
            "  --zen-colors-secondary: #"(jq -r '.colours.secondary' $scheme)" !important;" \
            "  --zen-colors-tertiary: #"(jq -r '.colours.surfaceContainer' $scheme)" !important;" \
            "  --zen-colors-primary-foreground: #"(jq -r '.colours.onPrimary' $scheme)" !important;" \
            "  --zen-colors-input-bg: #"(jq -r '.colours.surfaceBright' $scheme)" !important;" \
            "  --zen-colors-border-contrast: #"(jq -r '.colours.outlineVariant' $scheme)" !important;" \
            "  --zen-colors-border: #"(jq -r '.colours.outlineVariant' $scheme)" !important;" \
            "  --zen-colors-hover-bg: #"(jq -r '.colours.surfaceContainerHigh' $scheme)" !important;" \
            '}' \
            > "$css"
    end
end

# Generate immediately on startup
generate_css

# Watch Caelestia's scheme
inotifywait \
    -q \
    -e close_write,moved_to,create \
    -m \
    "$state_dir" |
while read -l dir events file
    if test "$dir$file" = "$scheme"
        sleep 0.1
        generate_css
    end
end
