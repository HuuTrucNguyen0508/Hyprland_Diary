#!/bin/sh
# Helium launcher. Always exposes a localhost CDP port so helium-hypr-layout
# can flip helium.browser.layout when the window changes monitors.

set -eu

APPIMAGE="$(ls -1 "$HOME"/Applications/helium-*.AppImage 2>/dev/null | sort | tail -n1 || true)"
if [ -z "${APPIMAGE}" ] || [ ! -x "${APPIMAGE}" ]; then
  echo "helium: no executable AppImage in ~/Applications/helium-*.AppImage" >&2
  exit 1
fi

PORT="${HELIUM_REMOTE_DEBUG_PORT:-9333}"

has_flag=0
for arg in "$@"; do
  case "$arg" in
    --remote-debugging-port|--remote-debugging-port=*) has_flag=1 ;;
  esac
done

if [ "$has_flag" -eq 0 ]; then
  exec "$APPIMAGE" \
    --remote-debugging-port="$PORT" \
    --remote-allow-origins=* \
    "$@"
fi

exec "$APPIMAGE" "$@"
