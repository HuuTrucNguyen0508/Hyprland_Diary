[Unit]
Description=Helium browser layout follows Hyprland monitor
Documentation=file://%h/Documents/Code/Hyprland_Diary/Helium-hypr-layout/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/helium-hypr-layout --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
